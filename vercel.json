{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.stringandracketfinder.com"
        }
      ],
      "destination": "https://stringandracketfinder.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/setups",
      "destination": "/index.html"
    },
    {
      "source": "/rackets",
      "destination": "/index.html"
    },
    {
      "source": "/racquets",
      "destination": "/index.html"
    },
    {
      "source": "/strings",
      "destination": "/index.html"
    },
    {
      "source": "/player",
      "destination": "/index.html"
    },
    {
      "source": "/calibrator",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(setups|rackets|racquets|strings|player|calibrator)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(brandmark|a3logo|og|icon-48|icon-96|icon-192|icon-maskable-192|icon-maskable-512).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon|icon-512|apple-touch-icon).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ]
}