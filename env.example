# Copy of every secret the API needs. In Vercel these live under
# Project → Settings → Environment Variables — NEVER in the HTML, never in git.

# 1) Neon Postgres — from neon.tech → your project → "Connection string" (pooled)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 2) Resend — from resend.com → API Keys. The sending domain must be verified
#    (add their DNS records at Squarespace, same panel as the site records).
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=login@stringandracketfinder.com

# 3) Session signing secret — any long random string; generate one with:
#    node -e "console.log(crypto.randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-64-random-hex-chars

# 4) Vercel Blob (photo uploads) — created automatically when you add Blob
#    storage to the project; Vercel injects it, listed here for completeness.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# 5) The site's public origin (used in the magic-link email)
SITE_ORIGIN=https://stringandracketfinder.com
