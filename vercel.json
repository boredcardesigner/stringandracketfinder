{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.stringandracketfinder.com" }],
      "destination": "https://stringandracketfinder.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/setups",     "destination": "/index.html" },
    { "source": "/rackets",    "destination": "/index.html" },
    { "source": "/racquets",   "destination": "/index.html" },
    { "source": "/strings",    "destination": "/index.html" },
    { "source": "/player",     "destination": "/index.html" },
    { "source": "/calibrator", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(setups|rackets|racquets|strings|player|calibrator)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
